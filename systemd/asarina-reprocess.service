[Unit]
Description=asarina archive reprocessing (D50 and SBT, newest frame first)
After=network-online.target remote-fs.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=mates
Group=mates
# asarina and pyrt installed system-wide; ~/bin last, for atlas (catalog extraction)
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/mates/bin
Environment=TERM=xterm
ExecStart=/usr/local/bin/asarina-reprocess run
# Frames being processed when stopped go back to the queue; let the main
# process kill them and record that before systemd kills the rest.
KillMode=mixed
TimeoutStopSec=60
Restart=always
RestartSec=60
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
